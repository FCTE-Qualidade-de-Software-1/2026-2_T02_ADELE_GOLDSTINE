% Imagem de fundo da capa (modelo FGA/FCTE)
\newcommand\BackgroundPic{%
	\put(0,0){%
		\parbox[b][\paperheight]{\paperwidth}{%
			\vfill
			\centering
			\includegraphics[width=\paperwidth,height=\paperheight,%
				keepaspectratio]{figuras/capa.eps}%
			\vfill
		}
	}
}

\renewcommand{\imprimircapa}{%
  \begin{capa}%
    \center
	\AddToShipoutPicture*{\BackgroundPic}

    \vspace*{2.9in}
	{\textbf{\large\imprimirinstituicao}}
	\par
	{\textbf{\large\imprimircurso}}

	\vspace{1.0in}

    {\ABNTEXchapterfont\bfseries\LARGE\imprimirtitulo}
    \par\vspace{0.2in}
    {\imprimirdisciplina\par Equipe \imprimirequipe}
    \vspace*{\fill}

	\begin{flushright}
		\textbf{Autores:}\par
		\imprimirautor\par
		\vspace{0.1in}
		\textbf{\imprimirorientadorRotulo~\imprimirorientador}
	\end{flushright}

    \vspace*{0.1in}
    \textbf{{\large\imprimirlocal}}
    \par
    \textbf{{\large\imprimirdata}}

    \vspace*{0.05in}
  \end{capa}
}
